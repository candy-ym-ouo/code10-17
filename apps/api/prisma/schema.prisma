generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETING
}

enum SessionStatus {
  DRAFT
  IN_REVIEW
  COMPLETED
  ARCHIVED
  DELETING
  DELETE_FAILED
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  CANCELLED
}

enum AnnotationType {
  RHYTHM
  FINGERING
  EMOTION
}

enum GoalCategory {
  RHYTHM
  FINGERING
  EMOTION
  CONTINUITY
  PITCH
  SPEED
  REPERTOIRE
  OTHER
}

enum MetricType {
  DURATION
  COUNT
  SPEED
  ACCURACY
  SUBJECTIVE_SCORE
  CUSTOM
}

enum EvidenceRequirement {
  NONE
  AUDIO
  SELF_REVIEW
  AUDIO_AND_SELF_REVIEW
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum GoalStatus {
  OPEN
  IN_PROGRESS
  ACHIEVED
  MISSED
  CANCELLED
}

enum EnsembleMemberRole {
  OWNER
  CONDUCTOR
  MEMBER
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
  PRESENT
  LATE
  ABSENT
}

enum RehearsalStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BarTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum RehearsalNotificationType {
  REHEARSAL_CREATED
  REHEARSAL_UPDATED
  REHEARSAL_CANCELLED
  MEMBER_ADDED
  MEMBER_REMOVED
  ATTENDANCE_UPDATED
  BAR_TASK_ASSIGNED
  BAR_TASK_UPDATED
}

enum NotificationStatus {
  UNREAD
  READ
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique @db.VarChar(254)
  passwordHash      String           @map("password_hash")
  displayName       String           @map("display_name") @db.VarChar(80)
  defaultInstrument String?          @map("default_instrument") @db.VarChar(60)
  timezone          String           @default("Asia/Shanghai") @db.VarChar(64)
  locale            String           @default("zh-CN") @db.VarChar(16)
  status            UserStatus       @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshSessions   RefreshSession[]
  practiceSessions  PracticeSession[]
  mediaAssets       MediaAsset[]
  annotations       Annotation[]
  goals             Goal[]
  goalProgresses    GoalProgress[]
  auditLogs         AuditLog[]
  dataExports       DataExport[]
  ensembleMemberships EnsembleMember[]
  deliveredNotifications DeliveredNotification[]

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  ipHash     String?   @map("ip_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PracticeSession {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  title            String             @db.VarChar(120)
  instrument       String             @db.VarChar(60)
  focus            String?            @db.VarChar(500)
  location         String?            @db.VarChar(120)
  notes            String?
  startedAt        DateTime           @map("started_at") @db.Timestamptz(6)
  actualDurationMs BigInt             @default(0) @map("actual_duration_ms")
  status           SessionStatus      @default(DRAFT)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(6)
  version          Int                @default(0)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAssets      MediaAsset[]
  annotations      Annotation[]
  goals            Goal[]
  goalProgresses   GoalProgress[]
  review           SessionReview?

  @@index([userId, status, startedAt(sort: Desc)])
  @@index([userId, instrument])
  @@index([userId, completedAt])
  @@map("practice_sessions")
}

model MediaAsset {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  status         MediaStatus     @default(PENDING_UPLOAD)
  objectKey      String          @map("object_key")
  originalName   String          @map("original_name") @db.VarChar(255)
  mimeType       String          @map("mime_type") @db.VarChar(100)
  sizeBytes      BigInt          @map("size_bytes")
  sha256         String          @db.Char(64)
  durationMs     BigInt?         @map("duration_ms")
  codec          String?         @db.VarChar(64)
  sampleRate     Int?            @map("sample_rate")
  channels       Int?            @db.SmallInt
  peaks          Json?
  failureCode    String?         @map("failure_code") @db.VarChar(64)
  failureMessage String?         @map("failure_message") @db.VarChar(500)
  uploadedAt     DateTime?       @map("uploaded_at") @db.Timestamptz(6)
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(6)
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  annotations    Annotation[]
  goalProgresses GoalProgress[]

  @@index([userId, sha256])
  @@index([objectKey])
  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("media_assets")
}

model Annotation {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  mediaId     String         @map("media_id") @db.Uuid
  type        AnnotationType
  severity    Int            @db.SmallInt
  startMs     BigInt         @map("start_ms")
  endMs       BigInt         @map("end_ms")
  title       String         @db.VarChar(80)
  description String?
  nextAction  String?        @map("next_action")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  media       MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  goals       Goal[]

  @@index([mediaId, startMs])
  @@index([userId, type])
  @@index([sessionId, severity])
  @@map("annotations")
}

model Goal {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  sourceSessionId    String              @map("source_session_id") @db.Uuid
  annotationId       String?             @map("annotation_id") @db.Uuid
  title              String              @db.VarChar(160)
  category           GoalCategory
  metricType         MetricType          @map("metric_type")
  baselineValue      Decimal?            @map("baseline_value") @db.Decimal(14, 4)
  targetValue        Decimal             @map("target_value") @db.Decimal(14, 4)
  unit               String              @db.VarChar(24)
  dueDate            DateTime            @map("due_date") @db.Date
  method             String?
  evidenceRequirement EvidenceRequirement @map("evidence_requirement")
  status             GoalStatus          @default(OPEN)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledReason    String?             @map("cancelled_reason")
  version            Int                 @default(0)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSession      PracticeSession     @relation(fields: [sourceSessionId], references: [id], onDelete: Cascade)
  annotation         Annotation?         @relation(fields: [annotationId], references: [id], onDelete: SetNull)
  progresses         GoalProgress[]

  @@index([userId, status, dueDate])
  @@index([sourceSessionId])
  @@map("goals")
}

model GoalProgress {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  goalId          String          @map("goal_id") @db.Uuid
  sessionId       String          @map("session_id") @db.Uuid
  evidenceMediaId String?         @map("evidence_media_id") @db.Uuid
  actualValue     Decimal         @map("actual_value") @db.Decimal(14, 4)
  note            String?
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  session         PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidenceMedia   MediaAsset?     @relation(fields: [evidenceMediaId], references: [id], onDelete: SetNull)

  @@index([goalId, recordedAt])
  @@index([sessionId])
  @@map("goal_progress")
}

model SessionReview {
  id                      String          @id @default(uuid()) @db.Uuid
  sessionId               String          @unique @map("session_id") @db.Uuid
  goodPoints              String?         @map("good_points")
  mainIssues              String?         @map("main_issues")
  nextFocus               String?         @map("next_focus") @db.VarChar(500)
  noIssues                Boolean         @default(false) @map("no_issues")
  suggestedNextPracticeAt DateTime?       @map("suggested_next_practice_at") @db.Timestamptz(6)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  session                 PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_reviews")
}

model DataExport {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  format     String        @db.VarChar(8)
  status     ExportStatus  @default(PENDING)
  objectKey  String?       @map("object_key") @db.Text
  failure    String?       @db.VarChar(500)
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("data_exports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  resource   String   @db.VarChar(80)
  resourceId String?  @map("resource_id") @db.Uuid
  result     String   @db.VarChar(32)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  traceId    String?  @map("trace_id") @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Ensemble {
  id          String             @id @default(uuid()) @db.Uuid
  ownerId     String             @map("owner_id") @db.Uuid
  name        String             @db.VarChar(120)
  description String?
  version     Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  members     EnsembleMember[]
  rehearsals  Rehearsal[]

  @@index([ownerId])
  @@map("ensembles")
}

model EnsembleMember {
  id          String              @id @default(uuid()) @db.Uuid
  ensembleId  String              @map("ensemble_id") @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  displayName String              @map("display_name") @db.VarChar(80)
  instrument  String              @db.VarChar(60)
  part        String              @db.VarChar(120)
  role        EnsembleMemberRole  @default(MEMBER)
  isActive    Boolean             @default(true) @map("is_active")
  leftAt      DateTime?           @map("left_at") @db.Timestamptz(6)
  version     Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  ensemble    Ensemble            @relation(fields: [ensembleId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance  AttendanceRecord[]
  barTasks    BarTask[]

  @@unique([ensembleId, userId])
  @@index([userId])
  @@index([ensembleId, isActive])
  @@map("ensemble_members")
}

model Rehearsal {
  id              String             @id @default(uuid()) @db.Uuid
  ensembleId      String             @map("ensemble_id") @db.Uuid
  title           String             @db.VarChar(120)
  piece           String?            @db.VarChar(160)
  location        String?            @db.VarChar(120)
  startsAt        DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime           @map("ends_at") @db.Timestamptz(6)
  status          RehearsalStatus    @default(SCHEDULED)
  notes           String?
  notificationSeq Int                @default(0) @map("notification_seq")
  version         Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  ensemble        Ensemble           @relation(fields: [ensembleId], references: [id], onDelete: Cascade)
  attendance      AttendanceRecord[]
  barTasks        BarTask[]
  notifications   RehearsalNotification[]

  @@index([ensembleId, startsAt(sort: Desc)])
  @@index([status, startsAt])
  @@map("rehearsals")
}

model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  rehearsalId     String           @map("rehearsal_id") @db.Uuid
  memberId        String           @map("member_id") @db.Uuid
  status          AttendanceStatus @default(PENDING)
  respondedOffline Boolean         @default(false) @map("responded_offline")
  respondedAt     DateTime?        @map("responded_at") @db.Timestamptz(6)
  note            String?          @db.VarChar(500)
  clientUpdatedAt DateTime?        @map("client_updated_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rehearsal       Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  member          EnsembleMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, memberId])
  @@index([memberId, status])
  @@map("attendance_records")
}

model BarTask {
  id           String        @id @default(uuid()) @db.Uuid
  rehearsalId  String        @map("rehearsal_id") @db.Uuid
  assigneeId   String?       @map("assignee_id") @db.Uuid
  startBar     Int           @map("start_bar")
  endBar       Int           @map("end_bar")
  title        String        @db.VarChar(160)
  focus        String?       @db.VarChar(500)
  status       BarTaskStatus @default(NOT_STARTED)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(6)
  version      Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  rehearsal    Rehearsal     @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  assignee     EnsembleMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([rehearsalId, startBar])
  @@index([assigneeId, status])
  @@map("bar_tasks")
}

model RehearsalNotification {
  id          String                     @id @default(uuid()) @db.Uuid
  rehearsalId String                     @map("rehearsal_id") @db.Uuid
  type        RehearsalNotificationType
  changeSeq   Int                        @map("change_seq")
  dedupeKey   String                     @unique @map("dedupe_key") @db.VarChar(160)
  actorId     String?                    @map("actor_id") @db.Uuid
  title       String                     @db.VarChar(160)
  body        String?
  payload     Json?
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  rehearsal   Rehearsal                  @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  deliveries  DeliveredNotification[]

  @@index([rehearsalId, changeSeq])
  @@map("rehearsal_notifications")
}

model DeliveredNotification {
  id             String               @id @default(uuid()) @db.Uuid
  notificationId String               @map("notification_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  status         NotificationStatus   @default(UNREAD)
  readAt         DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  notification   RehearsalNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("delivered_notifications")
}

/// 客户端幂等键的服务端记录：重试/离线回放时直接回放首次结果。
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.VarChar(80)
  scope        String   @db.VarChar(160)
  requestHash  String   @map("request_hash") @db.Char(8)
  statusCode   Int      @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, scope, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_records")
}

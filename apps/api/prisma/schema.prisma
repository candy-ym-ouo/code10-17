generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETING
}

enum SessionStatus {
  DRAFT
  IN_REVIEW
  COMPLETED
  ARCHIVED
  DELETING
  DELETE_FAILED
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  CANCELLED
}

enum AnnotationType {
  RHYTHM
  FINGERING
  EMOTION
}

enum GoalCategory {
  RHYTHM
  FINGERING
  EMOTION
  CONTINUITY
  PITCH
  SPEED
  REPERTOIRE
  OTHER
}

enum MetricType {
  DURATION
  COUNT
  SPEED
  ACCURACY
  SUBJECTIVE_SCORE
  CUSTOM
}

enum EvidenceRequirement {
  NONE
  AUDIO
  SELF_REVIEW
  AUDIO_AND_SELF_REVIEW
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum GoalStatus {
  OPEN
  IN_PROGRESS
  ACHIEVED
  MISSED
  CANCELLED
}

enum EnsembleMemberRole {
  OWNER
  MEMBER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  UNKNOWN
}

enum BarTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum RehearsalChangeKind {
  REHEARSAL_CREATED
  REHEARSAL_UPDATED
  REHEARSAL_CANCELLED
  ATTENDANCE_CHANGED
  BAR_TASK_CREATED
  BAR_TASK_UPDATED
  BAR_TASK_DELETED
  BAR_TASK_CONFIRMED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  READ
}

model Ensemble {
  id          String             @id @default(uuid()) @db.Uuid
  ownerId     String             @map("owner_id") @db.Uuid
  name        String             @db.VarChar(120)
  description String?
  version     Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User               @relation("EnsembleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     EnsembleMember[]
  rehearsals  Rehearsal[]

  @@map("ensembles")
}

model EnsembleMember {
  id          String      @id @default(uuid()) @db.Uuid
  ensembleId  String      @map("ensemble_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  part        String?     @db.VarChar(60)
  role        EnsembleMemberRole @default(MEMBER)
  active      Boolean     @default(true)
  version     Int         @default(0)
  joinedAt    DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  ensemble    Ensemble    @relation(fields: [ensembleId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances RehearsalAttendance[]
  assignments BarTaskAssignee[]
  checkins    BarTaskCheckin[]
  notifications RehearsalNotification[]

  @@unique([ensembleId, userId])
  @@index([ensembleId, active])
  @@map("ensemble_members")
}

model Rehearsal {
  id             String    @id @default(uuid()) @db.Uuid
  ensembleId     String    @map("ensemble_id") @db.Uuid
  title          String    @db.VarChar(120)
  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime  @map("scheduled_end") @db.Timestamptz(6)
  location       String?   @db.VarChar(120)
  notes          String?
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  ensemble       Ensemble  @relation(fields: [ensembleId], references: [id], onDelete: Cascade)
  attendances    RehearsalAttendance[]
  barTasks       BarTask[]
  changeEvents   RehearsalChangeEvent[]
  notifications  RehearsalNotification[]
  processedEvents RehearsalProcessedEvent[]

  @@index([ensembleId, scheduledStart])
  @@map("rehearsals")
}

model RehearsalAttendance {
  id            String           @id @default(uuid()) @db.Uuid
  rehearsalId   String           @map("rehearsal_id") @db.Uuid
  memberId      String           @map("member_id") @db.Uuid
  status        AttendanceStatus @default(UNKNOWN)
  note          String?          @db.VarChar(500)
  clientEventId String?          @map("client_event_id") @db.VarChar(80)
  occurredAt    DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  rehearsal     Rehearsal        @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  member        EnsembleMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, memberId])
  @@unique([rehearsalId, clientEventId], name: "attendance_event_idempotency")
  @@index([rehearsalId, status])
  @@map("rehearsal_attendances")
}

model BarTask {
  id           String       @id @default(uuid()) @db.Uuid
  rehearsalId  String       @map("rehearsal_id") @db.Uuid
  startBar     Int          @map("start_bar")
  endBar       Int          @map("end_bar")
  title        String       @db.VarChar(120)
  instruction  String?
  status       BarTaskStatus @default(OPEN)
  version      Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  rehearsal    Rehearsal    @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  assignees    BarTaskAssignee[]
  checkins     BarTaskCheckin[]

  @@index([rehearsalId, startBar])
  @@map("bar_tasks")
}

model BarTaskAssignee {
  id         String        @id @default(uuid()) @db.Uuid
  barTaskId  String        @map("bar_task_id") @db.Uuid
  memberId   String        @map("member_id") @db.Uuid
  assignedAt DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  barTask    BarTask       @relation(fields: [barTaskId], references: [id], onDelete: Cascade)
  member     EnsembleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([barTaskId, memberId])
  @@index([memberId])
  @@map("bar_task_assignees")
}

model BarTaskCheckin {
  id            String    @id @default(uuid()) @db.Uuid
  barTaskId     String    @map("bar_task_id") @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  done          Boolean
  note          String?   @db.VarChar(1000)
  clientEventId String?   @map("client_event_id") @db.VarChar(80)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  barTask       BarTask   @relation(fields: [barTaskId], references: [id], onDelete: Cascade)
  member        EnsembleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([barTaskId, memberId])
  @@unique([barTaskId, clientEventId], name: "checkin_event_idempotency")
  @@index([barTaskId, done])
  @@map("bar_task_checkins")
}

/// 变更事件账本：同一 (rehearsal_id, fingerprint) 唯一，保证通知变更幂等。
/// 客户端重放（同 Idempotency-Key 或同语义变更）在该约束上短路。
model RehearsalChangeEvent {
  id              String               @id @default(uuid()) @db.Uuid
  rehearsalId     String               @map("rehearsal_id") @db.Uuid
  actorMemberId   String?              @map("actor_member_id") @db.Uuid
  kind            RehearsalChangeKind
  /// 规范化后的语义指纹（kind + target + payload），用于同语义去重
  fingerprint     String               @db.Char(64)
  /// 客户端幂等键，同用户/合奏团下唯一
  idempotencyKey  String?              @unique(map: "change_event_idempotency_key") @map("idempotency_key") @db.VarChar(80)
  /// 触发该变更时的排练版本，便于增量同步
  versionSnapshot Int                  @map("version_snapshot")
  payload         Json?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  rehearsal       Rehearsal            @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  notifications   RehearsalNotification[]

  @@unique([rehearsalId, fingerprint], name: "change_event_fingerprint")
  @@index([rehearsalId, createdAt])
  @@map("rehearsal_change_events")
}

/// 每个成员的通知收件箱：事件去重后按成员展开，重复事件不产生新行。
model RehearsalNotification {
  id            String                     @id @default(uuid()) @db.Uuid
  rehearsalId   String                     @map("rehearsal_id") @db.Uuid
  changeEventId String                     @map("change_event_id") @db.Uuid
  recipientId   String                     @map("recipient_id") @db.Uuid
  status        NotificationDeliveryStatus @default(PENDING)
  readAt        DateTime?                  @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  rehearsal     Rehearsal                  @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)
  changeEvent   RehearsalChangeEvent       @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  recipient     EnsembleMember             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([changeEventId, recipientId])
  @@index([recipientId, status, createdAt])
  @@map("rehearsal_notifications")
}

/// 离线事件幂等账本：每个处理过的 clientEventId（含 LWW 落败者）留痕，
/// 保证“事件被更新事件覆盖后原设备重试”仍被识别为重放。
model RehearsalProcessedEvent {
  id           String   @id @default(uuid()) @db.Uuid
  rehearsalId  String   @map("rehearsal_id") @db.Uuid
  clientEventId String  @map("client_event_id") @db.VarChar(80)
  kind         RehearsalChangeKind
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  rehearsal    Rehearsal @relation(fields: [rehearsalId], references: [id], onDelete: Cascade)

  @@unique([rehearsalId, clientEventId])
  @@index([rehearsalId, processedAt])
  @@map("rehearsal_processed_events")
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique @db.VarChar(254)
  passwordHash      String           @map("password_hash")
  displayName       String           @map("display_name") @db.VarChar(80)
  defaultInstrument String?          @map("default_instrument") @db.VarChar(60)
  timezone          String           @default("Asia/Shanghai") @db.VarChar(64)
  locale            String           @default("zh-CN") @db.VarChar(16)
  status            UserStatus       @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshSessions   RefreshSession[]
  practiceSessions  PracticeSession[]
  mediaAssets       MediaAsset[]
  annotations       Annotation[]
  goals             Goal[]
  goalProgresses    GoalProgress[]
  auditLogs         AuditLog[]
  dataExports       DataExport[]
  ownedEnsembles    Ensemble[]       @relation("EnsembleOwner")
  ensembleMemberships EnsembleMember[]

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  ipHash     String?   @map("ip_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PracticeSession {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  title            String             @db.VarChar(120)
  instrument       String             @db.VarChar(60)
  focus            String?            @db.VarChar(500)
  location         String?            @db.VarChar(120)
  notes            String?
  startedAt        DateTime           @map("started_at") @db.Timestamptz(6)
  actualDurationMs BigInt             @default(0) @map("actual_duration_ms")
  status           SessionStatus      @default(DRAFT)
  completedAt      DateTime?          @map("completed_at") @db.Timestamptz(6)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(6)
  version          Int                @default(0)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAssets      MediaAsset[]
  annotations      Annotation[]
  goals            Goal[]
  goalProgresses   GoalProgress[]
  review           SessionReview?

  @@index([userId, status, startedAt(sort: Desc)])
  @@index([userId, instrument])
  @@index([userId, completedAt])
  @@map("practice_sessions")
}

model MediaAsset {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  status         MediaStatus     @default(PENDING_UPLOAD)
  objectKey      String          @map("object_key")
  originalName   String          @map("original_name") @db.VarChar(255)
  mimeType       String          @map("mime_type") @db.VarChar(100)
  sizeBytes      BigInt          @map("size_bytes")
  sha256         String          @db.Char(64)
  durationMs     BigInt?         @map("duration_ms")
  codec          String?         @db.VarChar(64)
  sampleRate     Int?            @map("sample_rate")
  channels       Int?            @db.SmallInt
  peaks          Json?
  failureCode    String?         @map("failure_code") @db.VarChar(64)
  failureMessage String?         @map("failure_message") @db.VarChar(500)
  uploadedAt     DateTime?       @map("uploaded_at") @db.Timestamptz(6)
  processedAt    DateTime?       @map("processed_at") @db.Timestamptz(6)
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  annotations    Annotation[]
  goalProgresses GoalProgress[]

  @@index([userId, sha256])
  @@index([objectKey])
  @@index([sessionId, status])
  @@index([expiresAt])
  @@map("media_assets")
}

model Annotation {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  sessionId   String         @map("session_id") @db.Uuid
  mediaId     String         @map("media_id") @db.Uuid
  type        AnnotationType
  severity    Int            @db.SmallInt
  startMs     BigInt         @map("start_ms")
  endMs       BigInt         @map("end_ms")
  title       String         @db.VarChar(80)
  description String?
  nextAction  String?        @map("next_action")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  media       MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  goals       Goal[]

  @@index([mediaId, startMs])
  @@index([userId, type])
  @@index([sessionId, severity])
  @@map("annotations")
}

model Goal {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  sourceSessionId    String              @map("source_session_id") @db.Uuid
  annotationId       String?             @map("annotation_id") @db.Uuid
  title              String              @db.VarChar(160)
  category           GoalCategory
  metricType         MetricType          @map("metric_type")
  baselineValue      Decimal?            @map("baseline_value") @db.Decimal(14, 4)
  targetValue        Decimal             @map("target_value") @db.Decimal(14, 4)
  unit               String              @db.VarChar(24)
  dueDate            DateTime            @map("due_date") @db.Date
  method             String?
  evidenceRequirement EvidenceRequirement @map("evidence_requirement")
  status             GoalStatus          @default(OPEN)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)
  cancelledReason    String?             @map("cancelled_reason")
  version            Int                 @default(0)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSession      PracticeSession     @relation(fields: [sourceSessionId], references: [id], onDelete: Cascade)
  annotation         Annotation?         @relation(fields: [annotationId], references: [id], onDelete: SetNull)
  progresses         GoalProgress[]

  @@index([userId, status, dueDate])
  @@index([sourceSessionId])
  @@map("goals")
}

model GoalProgress {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  goalId          String          @map("goal_id") @db.Uuid
  sessionId       String          @map("session_id") @db.Uuid
  evidenceMediaId String?         @map("evidence_media_id") @db.Uuid
  actualValue     Decimal         @map("actual_value") @db.Decimal(14, 4)
  note            String?
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  session         PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidenceMedia   MediaAsset?     @relation(fields: [evidenceMediaId], references: [id], onDelete: SetNull)

  @@index([goalId, recordedAt])
  @@index([sessionId])
  @@map("goal_progress")
}

model SessionReview {
  id                      String          @id @default(uuid()) @db.Uuid
  sessionId               String          @unique @map("session_id") @db.Uuid
  goodPoints              String?         @map("good_points")
  mainIssues              String?         @map("main_issues")
  nextFocus               String?         @map("next_focus") @db.VarChar(500)
  noIssues                Boolean         @default(false) @map("no_issues")
  suggestedNextPracticeAt DateTime?       @map("suggested_next_practice_at") @db.Timestamptz(6)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  session                 PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_reviews")
}

model DataExport {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  format     String        @db.VarChar(8)
  status     ExportStatus  @default(PENDING)
  objectKey  String?       @map("object_key") @db.Text
  failure    String?       @db.VarChar(500)
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("data_exports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(80)
  resource   String   @db.VarChar(80)
  resourceId String?  @map("resource_id") @db.Uuid
  result     String   @db.VarChar(32)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  traceId    String?  @map("trace_id") @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
